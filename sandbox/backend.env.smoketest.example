# Smoke-test env for the sandbox BACKEND — every value below is a throwaway
# placeholder, safe to commit. Use this to prove the stack builds and stays
# healthy (no crash-looping) BEFORE wiring up real secrets/domains.
#
# Usage: cp backend.env.smoketest.example .env
#
# What won't work with these values: OAuth login (no GitHub/ORCID/Globus
# creds), anything needing real domains (usermanagement/ml_service point at
# localhost here instead of their real *.sandbox.brainkb.org names), Mongo/
# Weaviate-backed features (blank on purpose). Everything else — Postgres,
# Oxigraph, pgAdmin, and all 4 supervised services staying RUNNING — should
# work and is exactly what this file is for verifying.

# =============================================================================
# Repo checkout path — only needed if your layout differs from the default
# =============================================================================
# BACKEND_REPO_PATH=../../BrainKB

# =============================================================================
# OAuth (backend-only) — left blank, login won't work with this file
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://sandbox.orcid.org

# =============================================================================
# Service ports
# =============================================================================
API_TOKEN_PORT=18000
QUERY_SERVICE_PORT=18010
ML_SERVICE_PORT=18007
USERMANAGEMENT_SERVICE_PORT=18004
UI_PORT=3080
NGINX_PORT=
WEB_CONCURRENCY=2

# ---- Postgres ----
JWT_POSTGRES_DATABASE_HOST_URL=postgres
JWT_POSTGRES_DATABASE_NAME=brainkb
JWT_POSTGRES_DATABASE_USER=postgres
JWT_POSTGRES_DATABASE_PASSWORD=smoketest123
JWT_POSTGRES_DATABASE_PORT=5432
POSTGRES_HOST_PORT=15432
JWT_POSTGRES_TABLE_SCOPE=Web_scope
JWT_POSTGRES_TABLE_USER=Web_jwtuser
JWT_POSTGRES_TABLE_USER_SCOPE_REL=Web_jwtuser_scopes
DB_HOST=postgres
DB_NAME=brainkb
DB_USER=postgres
DB_PASSWORD=smoketest123
DB_PORT=5432
POSTGRES_DB=brainkb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=smoketest123
POSTGRES_PORT=5432

# ---- JWT / auth secrets per service — throwaway strings, fine for a smoke test ----
JWT_ALGORITHM=HS256
BRAINYPEDIA_APITOKEN_MANAGER_SECRET_KEY=smoketest-secret-apitoken
ML_SERVICE_JWT_SECRET_KEY=smoketest-secret-ml
QUERY_SERVICE_JWT_SECRET_KEY=smoketest-secret-query
INGESTION_SERVICE_JWT_SECRET_KEY=smoketest-secret-ingestion
USERMANAGEMENT_SERVICE_JWT_SECRET_KEY=smoketest-secret-usermgmt
# Must be a valid Fernet key (32 url-safe base64 bytes) or usermanagement_service
# fails to start — this one was generated fresh for this smoke-test file only,
# never used anywhere real. Generate your own with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USERMANAGEMENT_OAUTH_TOKEN_ENC_KEY=4jjY9zclEHmiyWRw-y9sMaw7fU8Ocn2YRM9NSs4tMk0=
USERMANAGEMENT_BOOTSTRAP_SUPERADMIN_EMAILS=
USERMANAGEMENT_FRONTEND_CALLBACK_URL=http://localhost:3080/auth/callback
# Real sandbox default is https://usermanagement.sandbox.brainkb.org (doesn't
# exist yet) — overridden to localhost here since this file never tests OAuth.
USERMANAGEMENT_PUBLIC_BASE_URL=http://localhost:18004

# ---- User management: single-issuer SSO (RS256 + JWKS) ----
USERMANAGEMENT_JWT_ISSUER=brainkb-usermanagement
USERMANAGEMENT_ACCESS_TOKEN_TTL_MIN=15
USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN=720
USERMANAGEMENT_WEB_SESSION_TTL_MIN=720
USERMANAGEMENT_WEB_REFRESH_TTL_MIN=10080
USERMANAGEMENT_TOKEN_AUDIENCES=usermanagement,query_service,ml_service,chat_service
USERMANAGEMENT_CLI_CODE_LEN=20

# ---- User management: Personal Access Tokens (PATs) ----
USERMANAGEMENT_PAT_DEFAULT_DAYS=3
USERMANAGEMENT_PAT_MAX_DAYS=365
USERMANAGEMENT_PAT_MAX_PER_USER=20
USERMANAGEMENT_PAT_SLIDING=true

# ---- Query service SSO ----
QUERY_SERVICE_SSO_JWKS_URL=http://127.0.0.1:8004/.well-known/jwks.json
QUERY_SERVICE_SSO_ISSUER=brainkb-usermanagement
QUERY_SERVICE_SSO_AUDIENCE=query_service

# ---- Django (APItokenmanager) ----
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=smoketest123

# ---- Oxigraph — no FSx needed for a smoke test, plain Docker volume ----
OXIGRAPH_PORT=17878
OXIGRAPH_USER=admin
OXIGRAPH_PASSWORD=smoketest123
OXIGRAPH_DATA_PATH=
OXIGRAPH_TMP_PATH=
GRAPHDATABASE_TYPE=OXIGRAPH
GRAPHDATABASE_HOSTNAME=oxigraph
GRAPHDATABASE_PORT=7878
GRAPHDATABASE_USERNAME=admin
GRAPHDATABASE_PASSWORD=smoketest123
GRAPHDATABASE_REPOSITORY=
DEFAULT_NAMED_GRAPH=named_graph
ENABLE_KG_SOURCE=False
RAPID_RELEASE_FILE=data-release.yaml

# ---- pgAdmin ----
PGADMIN_PORT=15051
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=smoketest123
PGADMIN_SERVER_NAME=BrainKB PostgreSQL (smoke test)

# ---- Query / NER / ontology data stores — optional, left blank ----
QUERY_SERVICE_BASE_URL=
NER_COLLECTION=
NER_DATABASE=
ONTOLOGY_DATABASE=
MONGO_DB_URL=
WEAVIATE_API_KEY=
WEAVIATE_GRPC_HOST=
WEAVIATE_HTTP_HOST=

# ---- Ollama — not part of this compose file, leave blank ----
OLLAMA_API_ENDPOINT=
OLLAMA_MODEL=
OLLAMA_PORT=

# ---- External services / integrations — optional, left blank ----
ENV_STATE=sandbox
CORE_API_KEY=
EXTERNAL_PDF_EXTRACTION_SERVICE=
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=
GROBID_SERVER_URL_OR_EXTERNAL_SERVICE=
LOGTAIL_API_KEY=
NCBI_API_KEY=
OPENROUTER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SYNTHSCHOLAR_EMAIL=
