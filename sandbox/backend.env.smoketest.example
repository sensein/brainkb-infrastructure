# Smoke-test env for the sandbox BACKEND — every value below is either a
# throwaway placeholder or a genuinely non-sensitive config value (a port
# number, a feature flag). Safe to commit. Every single line below has its
# own comment saying which one it is, and why — no exceptions, on request
# after a close call earlier in this repo's history with values that looked
# more sensitive than they were.
#
# Usage: cp backend.env.smoketest.example .env
#
# What won't work with these values: OAuth login (no GitHub/ORCID/Globus
# creds), anything needing real domains (usermanagement/ml_service point at
# localhost here instead of their real *.sandbox.brainkb.org names), Mongo/
# Weaviate-backed features (blank on purpose). Everything else — Postgres,
# Oxigraph, pgAdmin, and all 4 supervised services staying RUNNING — should
# work and is exactly what this file is for verifying.

# Repo checkout path — commented out, not a value at all
# BACKEND_REPO_PATH=../../BrainKB

# --- OAuth (backend-only) ---
# blank on purpose — no GitHub OAuth app registered for this smoke test
GITHUB_CLIENT_ID=
# blank on purpose — same
GITHUB_CLIENT_SECRET=
# blank on purpose — no ORCID OAuth app registered for this smoke test
ORCID_CLIENT_ID=
# blank on purpose — same
ORCID_CLIENT_SECRET=
# real value, not a secret — ORCID's own public sandbox API base URL
ORCID_BASE_URL=https://sandbox.orcid.org

# --- Service ports — real config values, not secrets ---
# non-secret — host port for the API token manager
API_TOKEN_PORT=18000
# non-secret — host port for query_service
QUERY_SERVICE_PORT=18010
# non-secret — host port for ml_service
ML_SERVICE_PORT=18007
# non-secret — host port for usermanagement_service
USERMANAGEMENT_SERVICE_PORT=18004
# non-secret — informational only, matches sandbox's PM2 UI port elsewhere
UI_PORT=3080
# blank on purpose — not used by this compose file
NGINX_PORT=
# non-secret — gunicorn worker count, kept low for a lightweight smoke test
WEB_CONCURRENCY=2

# --- Postgres ---
# non-secret — internal Docker hostname of the postgres service
JWT_POSTGRES_DATABASE_HOST_URL=postgres
# non-secret — database name
JWT_POSTGRES_DATABASE_NAME=brainkb
# non-secret — username, not a credential by itself
JWT_POSTGRES_DATABASE_USER=postgres
# FAKE placeholder password, made up for this file — not a real credential
JWT_POSTGRES_DATABASE_PASSWORD=smoketest123
# non-secret — Postgres's real internal port, must stay 5432 (see comment
# further down about POSTGRES_HOST_PORT for the host-side mapping)
JWT_POSTGRES_DATABASE_PORT=5432
# non-secret — host-side port mapping only, offset from production's 5432
POSTGRES_HOST_PORT=15432
# non-secret — table name
JWT_POSTGRES_TABLE_SCOPE=Web_scope
# non-secret — table name
JWT_POSTGRES_TABLE_USER=Web_jwtuser
# non-secret — table name
JWT_POSTGRES_TABLE_USER_SCOPE_REL=Web_jwtuser_scopes
# non-secret — internal Docker hostname, same as JWT_POSTGRES_DATABASE_HOST_URL
DB_HOST=postgres
# non-secret — database name
DB_NAME=brainkb
# non-secret — username
DB_USER=postgres
# FAKE placeholder password, same made-up value as above — not real
DB_PASSWORD=smoketest123
# non-secret — Postgres's internal port
DB_PORT=5432
# non-secret — database name
POSTGRES_DB=brainkb
# non-secret — username
POSTGRES_USER=postgres
# FAKE placeholder password, same made-up value as above — not real
POSTGRES_PASSWORD=smoketest123
# non-secret — Postgres's internal port
POSTGRES_PORT=5432

# --- JWT / auth secrets per service — all FAKE placeholder strings below,
# made up for this file, not real credentials, not derived from anything real ---
# non-secret — algorithm name, not a key
JWT_ALGORITHM=HS256
# FAKE placeholder secret key, made up for this file — not real
BRAINYPEDIA_APITOKEN_MANAGER_SECRET_KEY=smoketest-secret-apitoken
# FAKE placeholder secret key, made up for this file — not real
ML_SERVICE_JWT_SECRET_KEY=smoketest-secret-ml
# FAKE placeholder secret key, made up for this file — not real
QUERY_SERVICE_JWT_SECRET_KEY=smoketest-secret-query
# FAKE placeholder secret key, made up for this file — not real
INGESTION_SERVICE_JWT_SECRET_KEY=smoketest-secret-ingestion
# FAKE placeholder secret key, made up for this file — not real
USERMANAGEMENT_SERVICE_JWT_SECRET_KEY=smoketest-secret-usermgmt
# This one must be a validly-formatted Fernet key (32 url-safe base64 bytes)
# or usermanagement_service crashes on startup — but it was freshly generated
# via `os.urandom(32)` purely to satisfy that format check. Pure randomness,
# never used anywhere, not derived from or related to any real key. Generate
# your own the same way if you'd rather not reuse this one:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
USERMANAGEMENT_OAUTH_TOKEN_ENC_KEY=4jjY9zclEHmiyWRw-y9sMaw7fU8Ocn2YRM9NSs4tMk0=
# blank on purpose — no superadmin bootstrap needed for a smoke test
USERMANAGEMENT_BOOTSTRAP_SUPERADMIN_EMAILS=
# non-secret — a localhost URL, not a credential
USERMANAGEMENT_FRONTEND_CALLBACK_URL=http://localhost:3080/auth/callback
# non-secret — a localhost URL. Real sandbox default is
# https://usermanagement.sandbox.brainkb.org (doesn't exist yet); overridden
# here since this file never tests real OAuth/domains.
USERMANAGEMENT_PUBLIC_BASE_URL=http://localhost:18004

# --- User management: single-issuer SSO (RS256 + JWKS) — all non-secret config ---
# non-secret — an issuer label string, not a key
USERMANAGEMENT_JWT_ISSUER=brainkb-usermanagement
# non-secret — a TTL number, in minutes
USERMANAGEMENT_ACCESS_TOKEN_TTL_MIN=15
# non-secret — a TTL number, in minutes
USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN=720
# non-secret — a TTL number, in minutes
USERMANAGEMENT_WEB_SESSION_TTL_MIN=720
# non-secret — a TTL number, in minutes
USERMANAGEMENT_WEB_REFRESH_TTL_MIN=10080
# non-secret — a list of service names, not credentials
USERMANAGEMENT_TOKEN_AUDIENCES=usermanagement,query_service,ml_service,chat_service
# non-secret — a length number
USERMANAGEMENT_CLI_CODE_LEN=20

# --- Personal Access Tokens config — all non-secret numbers/flags ---
# non-secret — a day count
USERMANAGEMENT_PAT_DEFAULT_DAYS=3
# non-secret — a day count
USERMANAGEMENT_PAT_MAX_DAYS=365
# non-secret — a count limit
USERMANAGEMENT_PAT_MAX_PER_USER=20
# non-secret — a boolean flag
USERMANAGEMENT_PAT_SLIDING=true

# --- Query service SSO — non-secret config, points at usermanagement's own
# public-key endpoint (JWKS is public by design, not a secret) ---
# non-secret — a local URL to a public-key endpoint
QUERY_SERVICE_SSO_JWKS_URL=http://127.0.0.1:8004/.well-known/jwks.json
# non-secret — must match USERMANAGEMENT_JWT_ISSUER above, a label not a key
QUERY_SERVICE_SSO_ISSUER=brainkb-usermanagement
# non-secret — a service-name label
QUERY_SERVICE_SSO_AUDIENCE=query_service

# --- Django (APItokenmanager) ---
# non-secret — a placeholder email address for the auto-created superuser
DJANGO_SUPERUSER_EMAIL=admin@example.com
# non-secret — a username
DJANGO_SUPERUSER_USERNAME=admin
# FAKE placeholder password, made up for this file — not real
DJANGO_SUPERUSER_PASSWORD=smoketest123

# --- Oxigraph — no FSx needed for a smoke test, plain Docker volume ---
# non-secret — host port
OXIGRAPH_PORT=17878
# non-secret — username
OXIGRAPH_USER=admin
# FAKE placeholder password, made up for this file — not real
OXIGRAPH_PASSWORD=smoketest123
# blank on purpose — no FSx bind mount for a smoke test, falls back to a
# plain Docker named volume
OXIGRAPH_DATA_PATH=
# blank on purpose — same, falls back to a Docker named volume
OXIGRAPH_TMP_PATH=
# non-secret — a type label
GRAPHDATABASE_TYPE=OXIGRAPH
# non-secret — internal Docker hostname
GRAPHDATABASE_HOSTNAME=oxigraph
# non-secret — Oxigraph's real internal port
GRAPHDATABASE_PORT=7878
# non-secret — username, matches OXIGRAPH_USER above
GRAPHDATABASE_USERNAME=admin
# FAKE placeholder password, same made-up value as OXIGRAPH_PASSWORD — not real
GRAPHDATABASE_PASSWORD=smoketest123
# blank on purpose — not needed for a smoke test
GRAPHDATABASE_REPOSITORY=
# non-secret — a graph name label
DEFAULT_NAMED_GRAPH=named_graph
# non-secret — a boolean feature flag, off for this smoke test
ENABLE_KG_SOURCE=False
# non-secret — a filename
RAPID_RELEASE_FILE=data-release.yaml

# --- pgAdmin ---
# non-secret — host port
PGADMIN_PORT=15051
# non-secret — a placeholder email address, this is pgAdmin's login, not a database credential
PGADMIN_DEFAULT_EMAIL=admin@example.com
# FAKE placeholder password, made up for this file — not real
PGADMIN_DEFAULT_PASSWORD=smoketest123
# non-secret — a display label shown in pgAdmin's UI
PGADMIN_SERVER_NAME=BrainKB PostgreSQL (smoke test)

# --- Query / NER / ontology data stores — all blank on purpose, not needed
# for a smoke test (these features are simply inactive without them) ---
# blank on purpose
QUERY_SERVICE_BASE_URL=
# blank on purpose
NER_COLLECTION=
# blank on purpose
NER_DATABASE=
# blank on purpose
ONTOLOGY_DATABASE=
# blank on purpose — see the note in backend.env.template: a real value here
# would be a full connection string with a username/password embedded in it
MONGO_DB_URL=
# blank on purpose — no Weaviate API key for this smoke test
WEAVIATE_API_KEY=
# blank on purpose
WEAVIATE_GRPC_HOST=
# blank on purpose
WEAVIATE_HTTP_HOST=

# --- Ollama — not part of this compose file at all, blank on purpose ---
# blank on purpose — Ollama isn't started by this compose file
OLLAMA_API_ENDPOINT=
# blank on purpose
OLLAMA_MODEL=
# blank on purpose
OLLAMA_PORT=

# --- External services / integrations ---
# non-secret — an environment label, not a credential
ENV_STATE=sandbox
# blank on purpose — no CORE API key for this smoke test
CORE_API_KEY=
# blank on purpose — feature left off
EXTERNAL_PDF_EXTRACTION_SERVICE=
# blank on purpose — no Globus OAuth app registered for this smoke test
GLOBUS_CLIENT_ID=
# blank on purpose — same
GLOBUS_CLIENT_SECRET=
# blank on purpose — no external GROBID service configured
GROBID_SERVER_URL_OR_EXTERNAL_SERVICE=
# blank on purpose — no Logtail API key for this smoke test
LOGTAIL_API_KEY=
# blank on purpose — no NCBI API key for this smoke test
NCBI_API_KEY=
# blank on purpose — no OpenRouter API key for this smoke test
OPENROUTER_API_KEY=
# blank on purpose — no Semantic Scholar API key for this smoke test
SEMANTIC_SCHOLAR_API_KEY=
# blank on purpose — not needed for this smoke test
SYNTHSCHOLAR_EMAIL=
