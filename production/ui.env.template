# Environment template for the BrainKB production FRONTEND (brainkb-ui).
# This becomes brainkb-ui's `.env.local`, used by `bin/up-node.sh` (PM2, not
# Docker — this repo's docker-compose.yml only covers the backend; see its
# header for why). Never commit the real `.env.local`.
#
# Derived from brainkb-ui's own `.env.deploy.example` (the authoritative
# source — re-check it directly if this drifts). OAuth provider credentials
# (GitHub/ORCID/Globus) are NOT needed here at all: they live purely in the
# backend's usermanagement_service env (backend.env.template); the UI just
# asks the backend which providers are configured.
#
# brainkb-ui also ships a Docker deploy path (`bin/up.sh` +
# docker-compose.proxy.yml) that bakes these same NEXT_PUBLIC_* vars as
# build args instead of loading them via PM2 — fully documented and working,
# but NOT what's currently used in production (confirmed directly: Tek Raj
# runs `bin/up-node.sh`). Worth knowing it exists as an alternative.

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL=https://beta.brainkb.org
NEXTAUTH_SECRET=

# =============================================================================
# PM2 process (bin/up-node.sh) — both overridable via env, no naming collision
# =============================================================================
PM2_APP_NAME=brainkb-ui
PORT=3000

# =============================================================================
# User management — confirmed live on its own domain (dig-verified)
# OAuth redirect URIs registered with GitHub/ORCID/Globus must match this host:
#   https://usermanagement.brainkb.org/api/auth/<provider>/callback
# Backend's USERMANAGEMENT_PUBLIC_BASE_URL must also be set to this URL.
# =============================================================================
NEXT_PUBLIC_USER_MANAGEMENT_API_BASE=https://usermanagement.brainkb.org
NEXT_PUBLIC_TOKEN_ENDPOINT_USER_MANAGEMENT_SERVICE=https://usermanagement.brainkb.org/api/token
NEXT_PUBLIC_CREATE_USER_PROFILE_ENDPOINT_USER_MANAGEMENT_SERVICE=https://usermanagement.brainkb.org/api/users/profile
NEXT_PUBLIC_GET_ENDPOINT_USER_PROFILE_USER_MANAGEMENT_SERVICE=https://usermanagement.brainkb.org/api/users/profile
NEXT_PUBLIC_UPDATE_ENDPOINT_USER_PROFILE_USER_MANAGEMENT_SERVICE=https://usermanagement.brainkb.org/api/users/profile
NEXT_PUBLIC_GET_ENDPOINT_USER_ACTIVITY_USER_MANAGEMENT_SERVICE=https://usermanagement.brainkb.org/api/users/activities
NEXT_PUBLIC_ENABLE_PAGE_ACCESS_GATE=true

# =============================================================================
# ML service — confirmed live on its own domain (dig-verified).
# =============================================================================
NEXT_PUBLIC_ML_SERVICE_API_BASE=https://mlservice.brainkb.org/
NEXT_PUBLIC_TOKEN_ENDPOINT_ML_SERVICE=https://mlservice.brainkb.org/api/token
NEXT_PUBLIC_API_NER_ENDPOINT=wss://mlservice.brainkb.org/api/ws/ner
NEXT_PUBLIC_API_PDF2REPROSCHEMA_ENDPOINT=wss://mlservice.brainkb.org/api/ws/pdf2reproschema
NEXT_PUBLIC_API_ADMIN_EXTRACT_STRUCTURED_RESOURCE_ENDPOINT=wss://mlservice.brainkb.org/api/ws/extract-resources
NEXT_PUBLIC_NER_GET_ENDPOINT=https://mlservice.brainkb.org/api/ner
NEXT_PUBLIC_NER_SAVE_ENDPOINT=https://mlservice.brainkb.org/api/save/ner
NEXT_PUBLIC_API_ADMIN_SAVE_STRUCTURED_RESOURCE_ENDPOINT=https://mlservice.brainkb.org/api/save/structured-resource
NEXT_PUBLIC_API_ADMIN_GET_STRUCTURED_RESOURCE_ENDPOINT=https://mlservice.brainkb.org/api/structured-resource

# =============================================================================
# Query service — confirmed NOT yet on its own domain; reached directly on
# the EC2 host's public IP, port 8010 (see bootstrap.md for the current IP —
# deliberately not hardcoded here since it's operational detail, not a
# stable domain, and could change).
# =============================================================================
NEXT_PUBLIC_TOKEN_ENDPOINT_QUERY_SERVICE=http://<host>:8010/api/token
NEXT_PUBLIC_API_QUERY_ENDPOINT=http://<host>:8010/api/query/sparql/
NEXT_PUBLIC_API_NAMED_GRAPH_QUERY_ENDPOINT=http://<host>:8010/api/query/registered-named-graphs
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_ENDPOINT=http://<host>:8010/api/insert/files/knowledge-graph-triples
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=http://<host>:8010/api/insert/jobs
NEXT_PUBLIC_API_ADMIN_INSERT_ALL_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=http://<host>:8010/api/insert/user/jobs/detail
NEXT_PUBLIC_API_ADMIN_INSERT_RECOVERY_JOB_ENDPOINT=http://<host>:8010/api/insert/jobs/recover
NEXT_PUBLIC_API_ADMIN_INSERT_CHECK_RECOVERABLE_JOB_ENDPOINT=http://<host>:8010/api/insert/jobs/check-recoverable

# =============================================================================
# Chat service — optional, port 8011. Confirmed NOT currently deployed/used
# in production — leave as-is or blank until that changes.
# =============================================================================
NEXT_PUBLIC_TOKEN_ENDPOINT_CHAT_SERVICE=http://<host>:8011/api/token
NEXT_PUBLIC_CHAT_SERVICE_API_ENDPOINT=http://<host>:8011/api/chat?stream=false

# =============================================================================
# Service-account JWT (UI → backend calls). Inlined into the browser bundle
# despite the name — treat as public; rotate on the backend if leaked.
# =============================================================================
NEXT_PUBLIC_JWT_USER=
NEXT_PUBLIC_JWT_PASSWORD=

# =============================================================================
# Misc
# =============================================================================
NEXT_PUBLIC_IPIFY_KEY=
NEXT_PUBLIC_USE_BEARER_TOKEN=true
