# Environment template for the BrainKB production BACKEND (docker-compose.yml).
# Copy to `.env` in this directory and fill in real values. Never commit `.env`.
#
# The frontend has its own separate template — see ui.env.template — because
# it's deployed differently (PM2 on the host, not this compose file). See
# docker-compose.yml's header for why.

# =============================================================================
# Repo checkout path (see ../README.md "Design note")
# Only needed if your layout differs from the default sibling-directory layout.
# =============================================================================
# BACKEND_REPO_PATH=../../BrainKB

# =============================================================================
# OAuth (backend-only — the UI does NOT need its own copy)
# Confirmed: brainkb-ui reads no GitHub/ORCID/Globus credentials at all: they
# live purely here, in usermanagement_service's env. The UI just asks the
# backend which providers are configured and renders only those buttons.
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=

# =============================================================================
# Service ports
# =============================================================================
API_TOKEN_PORT=8000
QUERY_SERVICE_PORT=8010
ML_SERVICE_PORT=8007
USERMANAGEMENT_SERVICE_PORT=8004
UI_PORT=3000
NGINX_PORT=
WEB_CONCURRENCY=

# ---- Postgres (app DB used by JWT / usermanagement / ml_service) ----
JWT_POSTGRES_DATABASE_HOST_URL=postgres
JWT_POSTGRES_DATABASE_NAME=brainkb
JWT_POSTGRES_DATABASE_USER=postgres
JWT_POSTGRES_DATABASE_PASSWORD=
# Always 5432 — this is the port services use to reach Postgres over the
# internal Docker network, NOT a host-exposed port. Do not change this to
# "match" whatever host port you want; use POSTGRES_HOST_PORT below for that.
JWT_POSTGRES_DATABASE_PORT=5432
# Host-side port mapping only (safe to offset per environment to avoid
# colliding with another stack's Postgres on the same machine).
POSTGRES_HOST_PORT=5432
JWT_POSTGRES_TABLE_SCOPE=
JWT_POSTGRES_TABLE_USER=
JWT_POSTGRES_TABLE_USER_SCOPE_REL=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ---- JWT / auth secrets per service ----
# Each service has its own JWT secret key so a token from one can't
# authenticate against another.
JWT_ALGORITHM=HS256
BRAINYPEDIA_APITOKEN_MANAGER_SECRET_KEY=
ML_SERVICE_JWT_SECRET_KEY=
QUERY_SERVICE_JWT_SECRET_KEY=
INGESTION_SERVICE_JWT_SECRET_KEY=
USERMANAGEMENT_SERVICE_JWT_SECRET_KEY=
USERMANAGEMENT_OAUTH_TOKEN_ENC_KEY=
USERMANAGEMENT_BOOTSTRAP_SUPERADMIN_EMAILS=
USERMANAGEMENT_FRONTEND_CALLBACK_URL=
USERMANAGEMENT_PUBLIC_BASE_URL=https://usermanagement.brainkb.org

# ---- User management: single-issuer SSO (RS256 + JWKS) ----
# usermanagement is the sole token issuer; other services verify access
# tokens against its published JWKS rather than sharing a symmetric secret.
USERMANAGEMENT_JWT_ISSUER=brainkb-usermanagement
USERMANAGEMENT_ACCESS_TOKEN_TTL_MIN=15
USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN=720
USERMANAGEMENT_WEB_SESSION_TTL_MIN=720
USERMANAGEMENT_WEB_REFRESH_TTL_MIN=10080
USERMANAGEMENT_TOKEN_AUDIENCES=usermanagement,query_service,ml_service,chat_service
USERMANAGEMENT_CLI_CODE_LEN=20

# ---- User management: Personal Access Tokens (PATs) ----
# Browser-free CLI/MCP auth — a user mints a PAT once, uses it thereafter.
USERMANAGEMENT_PAT_DEFAULT_DAYS=3
USERMANAGEMENT_PAT_MAX_DAYS=365
USERMANAGEMENT_PAT_MAX_PER_USER=20
USERMANAGEMENT_PAT_SLIDING=true

# ---- Query service: verifies RS256 tokens against usermanagement's JWKS ----
QUERY_SERVICE_SSO_JWKS_URL=http://127.0.0.1:8004/.well-known/jwks.json
QUERY_SERVICE_SSO_ISSUER=brainkb-usermanagement
QUERY_SERVICE_SSO_AUDIENCE=query_service

# ---- Django (APItokenmanager) ----
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# ---- Oxigraph (SPARQL store) ----
# OXIGRAPH_DATA_PATH / OXIGRAPH_TMP_PATH: production points these at an AWS
# FSx mount (e.g. /fsx/brainkb-kg-repo) that must already be mounted on the
# host, via plain Linux `mount`, BEFORE `docker compose up`. Confirm the
# current FSx filesystem ID / mount details before filling these in — see
# ../bootstrap.md once written.
OXIGRAPH_PORT=7878
OXIGRAPH_USER=admin
OXIGRAPH_PASSWORD=
OXIGRAPH_DATA_PATH=
OXIGRAPH_TMP_PATH=
GRAPHDATABASE_TYPE=
GRAPHDATABASE_HOSTNAME=
GRAPHDATABASE_PORT=
GRAPHDATABASE_USERNAME=
GRAPHDATABASE_PASSWORD=
GRAPHDATABASE_REPOSITORY=
DEFAULT_NAMED_GRAPH=
ENABLE_KG_SOURCE=
RAPID_RELEASE_FILE=

# ---- pgAdmin ----
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@brainkb.org
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_SERVER_NAME=BrainKB PostgreSQL

# ---- Query / NER / ontology data stores ----
QUERY_SERVICE_BASE_URL=
NER_COLLECTION=
NER_DATABASE=
ONTOLOGY_DATABASE=
# MONGO_DB_URL: a full connection string with the username/password embedded
# (mongodb+srv://user:pass@host/...) — treat the WHOLE VALUE as a secret, not
# just vars named *_PASSWORD/*_SECRET/*_KEY. Redaction tooling that only
# checks variable names will miss this.
MONGO_DB_URL=
WEAVIATE_API_KEY=
WEAVIATE_GRPC_HOST=
WEAVIATE_HTTP_HOST=

# ---- Ollama (local LLM) ----
# Not part of docker-compose.yml at all — start_services.sh runs it via a
# separate `docker run`, auto-detecting GPU via nvidia-smi /
# nvidia-container-toolkit. Confirm whether production actually uses GPU
# before assuming either path.
OLLAMA_API_ENDPOINT=
OLLAMA_MODEL=
OLLAMA_PORT=

# ---- External services / integrations ----
ENV_STATE=production
CORE_API_KEY=
EXTERNAL_PDF_EXTRACTION_SERVICE=
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=
GROBID_SERVER_URL_OR_EXTERNAL_SERVICE=
LOGTAIL_API_KEY=
NCBI_API_KEY=
OPENROUTER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SYNTHSCHOLAR_EMAIL=
